{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "environment": {},
      "enabled": true
    },
    "magicuidesign-mcp": {
      "type": "local",
      "command": ["pnpm", "dlx", "@magicuidesign/mcp@latest", "mcp"],
      "enabled": true
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    }
  }
}
